graph TD
    Start([Начало]) --> Step1[Составить список покупок дома]
    Step1 --> Step2[Взять деньги, карту и пакет]
    Step2 --> Step3[Дойти до магазина и взять корзину]
    Step3 --> Step4[Найти нужный товар из списка на полке]
    
    Step4 --> Cond1{Срок годности<br>в норме?}
    Cond1 -- Нет --> Step4
    Cond1 -- Да --> Step5[Положить товар в корзину]
    
    Step5 --> Step6[Вычеркнуть товар из списка]
    Step6 --> Cond2{Список<br>закончился?}
    
    Cond2 -- Нет --> Step4
    Cond2 -- Да --> Step7[Подойти к кассе и выложить продукты]
    
    Step7 --> Step8[Оплатить покупку]
    Step8 --> Step9[Сложить продукты в пакет]
    Step9 --> End([Конец: Забрать чек и выйти из магазина])
